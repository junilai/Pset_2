# Copiar a .env y completar. .env esta en .gitignore: nunca commitear credenciales.
# docker-compose.yml las pasa a Kestra como ENV_SNOWFLAKE_* (visibles en los flows como {{ envs.snowflake_* }})
# y al servicio dbt con estos mismos nombres (dbt/profiles.yml las lee con env_var()).

# Identificador de la cuenta, sin ".snowflakecomputing.com" (p. ej. ORGNAME-ACCOUNTNAME)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
# Base de datos con los esquemas BRONZE, SILVER y GOLD
SNOWFLAKE_DATABASE=ECU911
# Rol con permisos para crear objetos en esos esquemas
SNOWFLAKE_ROLE=
