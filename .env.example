# =============================================================================
# Copiar a .env y completar. .env NUNCA se sube a Git (ver .gitignore).
# =============================================================================

# --- Kestra (solo local) -----------------------------------------------------
# Usuario de la UI de Kestra: debe tener formato de email.
KESTRA_ADMIN_USER=admin@pset2.local
# Mínimo 8 caracteres, al menos una mayúscula y un número.
KESTRA_ADMIN_PASSWORD=CambiarEsto123
# Contraseña de la base Postgres interna de Kestra.
KESTRA_DB_PASSWORD=cambiar_esto

# --- Spark ---------------------------------------------------------------------
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2g

# --- Snowflake: admin (solo para el flow snowflake_setup) ----------------------
# Tu usuario de Snowflake con rol ACCOUNTADMIN
SNOWFLAKE_ADMIN_USER=
SNOWFLAKE_ADMIN_PASSWORD=

# --- Snowflake: cuenta -----------------------------------------------------------
# Identificador de cuenta, ej: abcdefg-xy12345 (sin .snowflakecomputing.com)
SNOWFLAKE_ACCOUNT=

# --- Snowflake: objetos de la tubería (los crea el flow snowflake_setup) --------
SNOWFLAKE_USER=ECU911_USER
SNOWFLAKE_PASSWORD=cambiar_esta_clave
SNOWFLAKE_ROLE=ECU911_ROLE
SNOWFLAKE_WAREHOUSE=ECU911_WH
SNOWFLAKE_DATABASE=ECU911
